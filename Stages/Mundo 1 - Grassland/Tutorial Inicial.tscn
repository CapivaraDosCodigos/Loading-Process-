[sub_resource type="GDScript" id="GDScript_ku2xw"]
resource_name = "PlataformaDoBoss"
script/source = "extends TileMapLayer

func _ready() -> void:
	collision_enabled = false
	visible = false
	ManagerGame.dead_boss.connect(_lose_boss)

func _lose_boss() -> void:
	collision_enabled = true
	visible = true
"

[sub_resource type="GDScript" id="GDScript_gko5w"]
resource_name = "Dash Tutorial"
script/source = "extends Area2D

func _on_body_entered(_body: Node2D) -> void:
	_tutorial.call_deferred()

func _tutorial() -> void:
	var tween: Tween = create_tween()
	
	tween.tween_method(Global.set_time_scale, 1.0, 0.01, 0.1)
	
	await tween.finished
	
	monitorable = false
	
	ManagerGame.items.append(Game.Item.Dash)
	
	ManagerGame.is_paused_force = true
	
	get_tree().paused = true

func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"Dash\") and not monitorable:
		get_tree().paused = false
		
		ManagerGame.is_paused_force = false
		
		Global.set_time_scale(1.0)
		
		await get_tree().create_timer(0.05).timeout
		
		ManagerGame.player.start_dash.call_deferred()
		
		queue_free.call_deferred()
"

