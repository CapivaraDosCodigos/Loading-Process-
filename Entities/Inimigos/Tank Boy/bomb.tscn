[sub_resource type="GDScript" id="GDScript_hswgu"]
resource_name = "é uma bomba"
script/source = "extends RigidBody2D

const EXPLOSION: PackedScene = preload(\"uid://b0uva68sp3g41\")
@onready var collision: CollisionShape2D = $Collision

func _ready() -> void:
	_verifique.call_deferred()

func _verifique() -> void:
	if self:
		SpawnManager.add_objeto_in_cache(self)

func _on_body_entered(body: Node) -> void:
	if body is Player2D:
		body._on_hurtbox_body_entered(self)
		
	visible = false
	var explosion_instance: Node2D = EXPLOSION.instantiate()
	explosion_instance.global_position = global_position
	add_sibling(explosion_instance)
	
	collision.set_deferred(\"disabled\", true)
	await explosion_instance.animation_finished
	queue_free()
"

